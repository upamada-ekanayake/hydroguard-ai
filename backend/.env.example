# Copy to .env and fill in real values. Never commit .env.
#
# Supabase Postgres. The direct host (db.<ref>.supabase.co) is IPv6-only, so use
# the IPv4 session pooler connection string from Supabase → Project Settings → Database.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase project keys (only needed if you switch to the Data API)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_KEY=your-anon-key

# Google Gemini. Free-tier keys rate-limit quickly; the pipeline falls back to
# heuristic alert text when the model is unavailable.
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
